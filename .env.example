# Copy to .env (gitignored) to run integration tests via ./gradlew integrationTest
# or the IntelliJ Gradle runner — no run-configuration env vars needed.
# NOTION_RUN_INTEGRATION_TESTS is set automatically by the integrationTest task.
NOTION_API_TOKEN=secret_...
NOTION_TEST_PAGE_ID=00000000-0000-0000-0000-000000000000
# Optional:
# NOTION_TEST_DATASOURCE_ID=...
# NOTION_TEST_USER_ID=...
# NOTION_CLEANUP_AFTER_TEST=false
# For WindowedDrainIntegrationTest's >10k drain (see its KDoc for setup):
# NOTION_TEST_LARGE_DATABASE_ID=...
# NOTION_TEST_LARGE_UNIQUE_ID_PROPERTY=ID
